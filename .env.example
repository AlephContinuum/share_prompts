# Copy to .env and fill in. Never commit the real .env.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# --- Google sign-in (NextAuth) ---
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # generate with: npx auth secret   (or any long random string)

# --- AI provider ---
# bedrock | gemini | mock. Leave empty to auto-pick the first one configured (mock if none).
LLM_PROVIDER=

# Amazon Bedrock (Converse API)
BEDROCK_REGION=us-east-1
# Only needed outside AWS. On Amplify/Lambda/EC2 prefer an IAM role instead of keys.
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
# Comma-separated model IDs shown in the Playground (must be enabled in your Bedrock console)
BEDROCK_MODELS=amazon.nova-micro-v1:0,amazon.nova-lite-v1:0,amazon.nova-pro-v1:0
BEDROCK_JUDGE_MODEL=amazon.nova-pro-v1:0
BEDROCK_UTILITY_MODEL=amazon.nova-lite-v1:0

# Google Gemini (free tier, good for local development)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
