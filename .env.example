# Copy to .env and fill in. Never commit the real .env.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# --- Google sign-in (NextAuth) ---
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=   # generate with: npx auth secret   (or any long random string)

# --- AI providers ---
# Fill in any of these. Every provider with a key is enabled, and the Playground can
# compare models across providers. With none set, the app runs in demo (mock) mode.
# Model lists are comma-separated; a model id elsewhere is written "provider:model".

# Groq (free tier, very fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite

# NVIDIA API catalog (free credits): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,minimaxai/minimax-m3.1-flash

# Verda inference (Kimi K3.1 Pro; subscribe to the model in the Verda console): https://verda.com/inference
VERDA_API_KEY=
VERDA_MODELS=kimi-k3-1-pro

# OpenAI (paid, needs credit): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini,gpt-5.4-mini

# DeepSeek (paid, needs a balance top-up): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

# Amazon Bedrock (Converse API)
# Set BEDROCK_ENABLED=true when the server has an IAM role (Amplify compute role, EC2, Lambda).
# For local development, an IAM user's access keys turn it on instead.
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_MODELS=amazon.nova-micro-v1:0,amazon.nova-lite-v1:0,amazon.nova-pro-v1:0

# Optional: which model judges the Playground and which one powers "Improve with AI".
# Defaults to the first configured provider (Bedrock, Groq, Gemini, NVIDIA, Verda, OpenAI, DeepSeek).
JUDGE_MODEL=
UTILITY_MODEL=
